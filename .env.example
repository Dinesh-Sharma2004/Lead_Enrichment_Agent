# ===========================================================================
# Autonomous Lead Enrichment Agent - Environment Variables
# ===========================================================================

# Required Credentials
GROQ_API_KEY=your_groq_api_key_here
SERPAPI_API_KEY=your_serpapi_api_key_here
ENABLE_SERPAPI=True

# Runtime Performance & Crawling Constraints
MAX_CONCURRENT_DOMAINS=3
MAX_PAGES_PER_DOMAIN=5
TIMEOUT_SECONDS=30
LLM_MODEL=openai/gpt-oss-120b
MAX_RETRIES=2
TOTAL_CONTEXT_CHAR_BUDGET=16000

# Vercel Services & Serverless Limits
MAX_DOMAINS_PER_REQUEST=3
BATCH_TIMEOUT_SECONDS=55

# Optional Frontend Local Dev Proxy
BACKEND_URL=http://127.0.0.1:8000
